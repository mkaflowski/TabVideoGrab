{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "downloads",
    "tabs",
    "clipboardWrite",
    "nativeMessaging",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/util.js",
      "lib/i18n.js",
      "lib/hdr.js",
      "lib/hls.js",
      "lib/dash.js",
      "lib/probe.js",
      "lib/youtube.js",
      "lib/sink.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabvideograb@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
